@page "/books"
@using Library.Core.Common
@using Library.Core.DTOs
@using Library.UI.Components.Shared
@using Library.UI.HttpServices.Interfaces
@inject IBookService BookService
@inject IToastService Toast

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Kitap Yönetim Paneli</h3>
        <button class="btn btn-primary" @onclick="OpenAddModal" disabled="@isBusy">Yeni Kitap Ekle</button>
    </div>

    <!-- REUSABLE SEARCH BOX -->
    <div class="row mb-3">
        <div class="col-md-6">
            <SearchBox @bind-SearchTerm="searchTerm" 
                       OnSearch="HandleSearch" 
                       OnClear="ClearSearch" 
                       Placeholder="Başlık veya Yazar ile ara..." 
                       Disabled="@isBusy" />
        </div>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center align-items-center gap-2 py-4">
            <div class="spinner-border text-primary" role="status"></div>
            <span>Yükleniyor...</span>
        </div>
    }
    else if (loadError != null)
    {
        <div class="alert alert-danger d-flex justify-content-between align-items-center">
            <span>@loadError</span>
            <button class="btn btn-sm btn-outline-danger" @onclick="RefreshList">Tekrar Dene</button>
        </div>
    }
    else if (books == null || !books.Any())
    {
        <div class="alert alert-secondary text-center">Kayıt bulunamadı.</div>
    }
    else
    {
        <table class="table table-bordered table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Kitap Adı</th>
                    <th>Yazar</th>
                    <th>ISBN</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in books)
                {
                    <!-- BOOK TABLE ROW COMPONENT -->
                    <BookTableRow Book="book" 
                                  EditingBook="editingBook" 
                                  IsEditing="@(editingBookId == book.Id)" 
                                  IsBusy="@isBusy" 
                                  OnStartEdit="() => StartEdit(book)" 
                                  OnCancelEdit="CancelEdit" 
                                  OnSave="() => SaveRow(book)" 
                                  OnPromptDelete="() => PromptDelete(book)" />
                }
            </tbody>
        </table>

        <!-- REUSABLE PAGINATION COMPONENT -->
        <Pagination CurrentPage="currentPage" 
                    TotalPages="pagedResult.TotalPages" 
                    TotalCount="pagedResult.TotalCount" 
                    Disabled="@isBusy" 
                    OnPageChanged="GoToPage" />
    }
</div>

<!-- BOOK FORM MODAL COMPONENT -->
<BookFormModal IsOpen="showAddModal" 
               BookModel="newBook" 
               IsBusy="isBusy" 
               OnSubmit="HandleAddBook" 
               OnClose="CloseAddModal" />

<!-- REUSABLE CONFIRM DIALOG -->
<ConfirmDialog IsOpen="showDeleteDialog" 
               Title="Kayıt Silme Onayı" 
               Message="@($"\"{selectedBookForDelete?.Title}\" isimli kitabı sistemden silmek istediğinize emin misiniz?")" 
               ConfirmButtonText="Evet, Sil" 
               IsBusy="isBusy" 
               OnConfirm="ConfirmDelete" 
               OnCancel="CancelDelete" />

@code {
    private List<BookDto>? books;
    private PagedResult<BookDto> pagedResult = new();

    private int currentPage = 1;
    private int pageSize = 5;
    private string? searchTerm;

    private BookDto newBook = new();
    private BookDto editingBook = new();

    private bool showAddModal = false;
    private bool showDeleteDialog = false;
    private int editingBookId = 0;
    private BookDto? selectedBookForDelete;

    private bool isLoading = true;
    private bool isBusy = false;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        await RefreshList();
    }

    private async Task RefreshList()
    {
        isLoading = true;
        loadError = null;
        try
        {
            pagedResult = await BookService.GetBooksAsync(searchTerm, currentPage, pageSize);
            books = pagedResult.Items;
        }
        catch (Exception)
        {
            loadError = "Kitaplar yüklenirken bir hata oluştu. Lütfen API bağlantısını kontrol edip tekrar deneyin.";
            books = new List<BookDto>();
            pagedResult = new PagedResult<BookDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSearch()
    {
        currentPage = 1;
        await RefreshList();
    }

    private async Task ClearSearch()
    {
        searchTerm = null;
        currentPage = 1;
        await RefreshList();
    }

    private async Task GoToPage(int page)
    {
        currentPage = page;
        await RefreshList();
    }

    private void OpenAddModal() { newBook = new(); showAddModal = true; }
    private void CloseAddModal() => showAddModal = false;

    private async Task HandleAddBook()
    {
        isBusy = true;
        try
        {
            var success = await BookService.AddBookAsync(newBook);
            if (success)
            {
                showAddModal = false;
                Toast.ShowSuccess($"\"{newBook.Title}\" başarıyla eklendi.");
                await RefreshList();
            }
            else
            {
                Toast.ShowError("Kitap eklenirken bir hata oluştu.");
            }
        }
        catch (Exception)
        {
            Toast.ShowError("Sunucuya ulaşılamadı. Kitap eklenemedi.");
        }
        finally
        {
            isBusy = false;
        }
    }

    private void StartEdit(BookDto book)
    {
        editingBookId = book.Id;
        editingBook = new BookDto
        {
            Id = book.Id,
            Title = book.Title,
            Author = book.Author,
            ISBN = book.ISBN,
            IsAvailable = book.IsAvailable
        };
    }

    private void CancelEdit() => editingBookId = 0;

    private async Task SaveRow(BookDto originalBook)
    {
        if (string.IsNullOrWhiteSpace(editingBook.Title) || string.IsNullOrWhiteSpace(editingBook.Author) || string.IsNullOrWhiteSpace(editingBook.ISBN))
        {
            Toast.ShowWarning("Lütfen tüm alanları doldurun.");
            return;
        }

        isBusy = true;
        try
        {
            var success = await BookService.UpdateBookAsync(originalBook.Id, editingBook);
            if (success)
            {
                editingBookId = 0;
                Toast.ShowSuccess("Kitap bilgileri güncellendi.");
                await RefreshList();
            }
            else
            {
                Toast.ShowError("Güncelleme sırasında bir hata oluştu.");
            }
        }
        catch (Exception)
        {
            Toast.ShowError("Sunucuya ulaşılamadı. Güncelleme yapılamadı.");
        }
        finally
        {
            isBusy = false;
        }
    }

    private void PromptDelete(BookDto book)
    {
        selectedBookForDelete = book;
        showDeleteDialog = true;
    }

    private void CancelDelete() => showDeleteDialog = false;

    private async Task ConfirmDelete()
    {
        if (selectedBookForDelete == null) return;

        isBusy = true;
        try
        {
            var success = await BookService.DeleteBookAsync(selectedBookForDelete.Id);
            if (success)
            {
                showDeleteDialog = false;
                Toast.ShowSuccess($"\"{selectedBookForDelete.Title}\" silindi.");
                await RefreshList();
            }
            else
            {
                Toast.ShowError("Silme işlemi sırasında bir hata oluştu.");
            }
        }
        catch (Exception)
        {
            Toast.ShowError("Sunucuya ulaşılamadı. Kitap silinemedi.");
        }
        finally
        {
            isBusy = false;
        }
    }
}